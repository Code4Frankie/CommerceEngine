NODE_ENV=development
PORT=5000

# MongoDB Atlas (Ahile creates the cluster and shares the string privately)
MONGO_URI=
# Separate database used only by the tests. The database name must contain the word test
MONGO_URI_TEST=
# Optional: set if the Atlas mongodb+srv lookup fails on your network
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origins allowed by CORS (comma separated). The first one is used in password reset links
CLIENT_URLS=http://localhost:5173

# Cloudinary (Ahile creates the account and shares the keys privately)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment gateway (written for Paystack)
PAYMENT_SECRET_KEY=
PAYMENT_BASE_URL=https://api.paystack.co
PAYMENT_CURRENCY=NGN
PAYMENT_CALLBACK_URL=

# Emails (if SMTP_HOST is empty, emails are printed in the terminal instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopCore <no-reply@shopcore.dev>

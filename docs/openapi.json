{
  "openapi": "3.0.3",
  "info": {
    "title": "ShopCore API",
    "version": "1.0.0",
    "description": "The core engine behind online commerce, for local businesses and products. Log in, copy the token, click Authorize and paste it (no 'Bearer' prefix)."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
